[{"ad_archive_id": "2585599921898810", "collation_count": null, "collation_id": null, "is_active": true, "page_id": "707730169083064", "page_is_deleted": false, "snapshot": {"branded_content": null, "page_id": "707730169083064", "page_is_deleted": false, "page_profile_uri": "https://www.facebook.com/61577029504746/", "root_reshared_post": null, "byline": null, "disclaimer_label": null, "page_name": "OdontoCompany Valparaíso-SP", "page_profile_picture_url": "https://scontent-bru2-1.xx.fbcdn.net/v/t39.35426-6/763722402_1795277951905593_4827729986712748012_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=111&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=9xpz-mAzrcMQ7kNvwF_9crR&_nc_oc=Adr3eysCrtOylYdwED_TTF42_KiObw-iVyx87uf6c0JaLUwRWcru6wiYwR_9_1keDD8&_nc_zt=14&_nc_ht=scontent-bru2-1.xx&_nc_gid=W7HdyFefs_6p9790PpNHDA&_nc_ss=7f289&oh=00_AQEH4exrSTrfPep1uzfftB0nvf1d7r05oNPaO8zhp14c1g&oe=6A83A349", "event": null, "caption": "instagram.com", "cta_text": "Visit Instagram profile", "cards": [], "body": {"text": "🦷❤️ Doença periodontal e endocardite: um risco real\n\nA doença periodontal — inflamação crônica dos tecidos que sustentam os dentes — vai muito além de sangramento gengival ou perda dentária.\n\n📊 O dado é alarmante:\nPacientes com doença periodontal têm 5,3 vezes mais chance de desenvolver doenças cardiovasculares.\n\n🦠 Uma das principais consequências é a endocardite infecciosa, uma infecção das válvulas do coração que pode causar complicações graves, como insuficiência cardíaca.\n\n🔬 O mecanismo é sistêmico:\n\nA inflamação crônica desencadeia uma resposta inflamatória generalizada, favorecendo a formação de placas ateroscleróticas, um dos principais fatores de risco para infarto e AVC.\n\n🩺 O papel do cirurgião-dentista é decisivo:\n\nAntes de procedimentos como o tratamento endodôntico, é fundamental uma avaliação clínica e radiográfica criteriosa, especialmente em pacientes com cardiopatias.\n\n⚠️ Cuidados essenciais incluem:\n\n* Planejamento adequado do atendimento\n* Controle da ansiedade e do tempo de consulta\n* Profilaxia antibiótica quando indicada\n* Manejo correto do sangramento e da dor\n* Não interromper anticoagulantes em procedimentos de baixo risco, conforme protocolos atuais\n\n💡 Resumo:\nPrevenção odontológica é também prevenção cardiovascular.\n\nNotícia completa em:\n\nhttps://www.atribuna.com.br/galeria/comportamento/avc-e-infarto-podem-ser-causados-por-problemas-silenciosos-nos-dentes-especialistas-explicam-1.472783"}, "cta_type": "VIEW_INSTAGRAM_PROFILE", "display_format": "IMAGE", "link_description": null, "link_url": "http://instagram.com/odontocompany_valparaiso_sp", "images": [{"image_crops": [], "original_image_url": "https://scontent-bru2-1.xx.fbcdn.net/v/t39.35426-6/762867238_1727026885281522_3034895140213781190_n.jpg?_nc_cat=105&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=Wnw7yru9MswQ7kNvwGRLGls&_nc_oc=AdrtJweezXGdLqeY280vSiUJIOCf7j19f5K3mZRMShdO56v0dm1X14cHUpo4a7Hw49U&_nc_zt=14&_nc_ht=scontent-bru2-1.xx&_nc_gid=W7HdyFefs_6p9790PpNHDA&_nc_ss=7f289&oh=00_AQFK2OGtcrIl96xmBlG9Stw98ihz21jV-EXhwfHNbjXZTA&oe=6A83D123", "resized_image_url": "https://scontent-bru2-1.xx.fbcdn.net/v/t39.35426-6/764854959_1354271589655228_8453955810650877989_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=109&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=d2GzgwVXDtIQ7kNvwHceBqx&_nc_oc=Adonwc0npTZv9K-tFkjbCh52Om0n9u5oI5_utpIQVkaTFKIFV7EoQzx5ndQ2cHfj4qg&_nc_zt=14&_nc_ht=scontent-bru2-1.xx&_nc_gid=W7HdyFefs_6p9790PpNHDA&_nc_ss=7f289&oh=00_AQHYLTxiAavHHzqgHsKWMmY4gX4v5vE80tjyWxARTIh21g&oe=6A83B413", "watermarked_resized_image_url": ""}], "page_categories": ["Dentist"], "page_like_count": 45, "title": "instagram.com", "videos": [], "is_reshared": false, "extra_links": [], "extra_texts": [], "extra_images": [], "extra_videos": [], "country_iso_code": null, "brazil_tax_id": null, "additional_info": null, "ec_certificates": []}, "has_user_reported": false, "report_count": null, "menu_items": [], "state_media_run_label": null, "page_name": "OdontoCompany Valparaíso-SP", "impressions_with_inde